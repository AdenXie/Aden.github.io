{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "cross-env TZ=Asia/Shanghai hexo generate",
    "build:english": "cross-env TZ=Asia/Shanghai hexo generate --config _config.yml,_config.english.yml --force",
    "clean": "cross-env TZ=Asia/Shanghai hexo clean",
    "deploy": "cross-env TZ=Asia/Shanghai hexo deploy",
    "release": "npm run build:site && npm run deploy",
    "server": "cross-env TZ=Asia/Shanghai hexo server",
    "build:site": "node tools/build-site.cjs",
    "prepare:site": "node tools/prepare-site.cjs",
    "optimize": "node tools/optimize-site.cjs",
    "test": "node --test test/*.test.cjs",
    "preview": "node tools/preview.cjs",
    "benchmark": "node tools/benchmark.cjs",
    "prebuild": "npm run prepare:site",
    "prebuild:english": "npm run prepare:site",
    "preserver": "npm run prepare:site"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-mathjax": "^0.11.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-redefine": "2.9.0",
    "hexo-wordcount": "^6.0.1",
    "nodejieba": "file:packages/nodejieba-compat",
    "twikoo": "1.7.20"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "cheerio": "^1.0.0",
    "clean-css": "5.3.3",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "fonteditor-core": "2.6.3",
    "js-yaml": "4.3.2",
    "playwright": "1.63.0",
    "sharp": "0.35.4"
  }
}
