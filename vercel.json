{
  "git": {
    "deploymentEnabled": {
      "source": false,
      "exchange-rates": false
    }
  },
  "functions": {
    "api/chat.js": {
      "maxDuration": 65
    }
  },
  "headers": [
    {
      "source": "/fonts/reading/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/chat",
      "destination": "/?chat=open",
      "permanent": false
    },
    {
      "source": "/chat/",
      "destination": "/?chat=open",
      "permanent": false
    },
    {
      "source": "/en/chat",
      "destination": "/en/?chat=open",
      "permanent": false
    },
    {
      "source": "/en/chat/",
      "destination": "/en/?chat=open",
      "permanent": false
    }
  ]
}