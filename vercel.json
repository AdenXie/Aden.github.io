{
  "git": {
    "deploymentEnabled": {
      "source": false,
      "exchange-rates": false
    }
  },
  "functions": {
    "api/chat.js": {
      "maxDuration": 65
    }
  },
  "headers": [
    {
      "source": "/fonts/reading/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/chat",
      "destination": "/?chat=open",
      "permanent": false
    },
    {
      "source": "/chat/",
      "destination": "/?chat=open",
      "permanent": false
    },
    {
      "source": "/en/chat",
      "destination": "/en/?chat=open",
      "permanent": false
    },
    {
      "source": "/en/chat/",
      "destination": "/en/?chat=open",
      "permanent": false
    },
    {
      "source": "/categories/daily",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/categories/daily/(.*)",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/categories/%E6%AF%8F%E6%97%A5%E7%AE%80%E6%8A%A5",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/categories/%E6%AF%8F%E6%97%A5%E7%AE%80%E6%8A%A5/(.*)",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/en/categories/daily",
      "destination": "/en/daily/",
      "permanent": true
    },
    {
      "source": "/en/categories/daily/(.*)",
      "destination": "/en/daily/",
      "permanent": true
    },
    {
      "source": "/en/categories/%E6%AF%8F%E6%97%A5%E7%AE%80%E6%8A%A5",
      "destination": "/en/daily/",
      "permanent": true
    },
    {
      "source": "/en/categories/%E6%AF%8F%E6%97%A5%E7%AE%80%E6%8A%A5/(.*)",
      "destination": "/en/daily/",
      "permanent": true
    }
  ]
}