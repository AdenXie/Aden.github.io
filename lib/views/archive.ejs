<%# Archive page (scripts/archive-view.js): a title and count, then the year and month sections. %>
<% const english = (config.language || '').startsWith('en'); const posts = site.posts.sort('-date').toArray(); const years = aden_archive_groups(posts, english).length; %>
<header class="aden-archive-header">
    <h1 class="page-title-header"><%= english ? 'Archive' : '归档' %></h1>
    <p class="aden-archive-summary"><%= english ? `${posts.length} posts · ${years} ${years === 1 ? 'year' : 'years'}` : `共 ${posts.length} 篇 · ${years} 个年份` %></p>
</header>
<%- partial('pages/archive/post-index', { posts, showCategories: true }) %>
