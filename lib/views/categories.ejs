<%# Category index (scripts/archive-view.js): one card per category, largest first. %>
<% const english = (config.language || '').startsWith('en'); const cards = aden_category_cards(site.categories); const total = cards.reduce((sum, card) => sum + card.count, 0); %>
<header class="aden-archive-header">
    <h1 class="page-title-header"><%= english ? 'Categories' : '分类' %></h1>
    <p class="aden-archive-summary"><%= english ? `${cards.length} categories · ${total} posts` : `${cards.length} 个分类 · 共 ${total} 篇` %></p>
</header>
<ol class="aden-category-grid">
    <% cards.forEach((card, index) => { %>
        <li class="aden-category-card<%= card.major ? ' is-major' : '' %>">
            <article class="aden-category-body">
                <header class="aden-category-head">
                    <span class="aden-category-index" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
                    <h2 class="aden-category-name"><a href="<%- url_for(card.path) %>"><%= card.name %></a></h2>
                </header>
                <p class="aden-category-count"><span class="aden-category-number"><%= card.count %></span><span><%= english ? (card.count === 1 ? 'post' : 'posts') : '篇' %></span></p>
                <ul class="aden-category-recent">
                    <% card.recent.forEach(post => { %>
                        <li>
                            <time class="aden-archive-date" datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM-DD') %></time>
                            <a href="<%- url_for(post.path) %>" title="<%= post.title %>"><%= post.title %></a>
                        </li>
                    <% }) %>
                </ul>
                <p class="aden-category-updated"><%= english ? 'Updated' : '最近更新' %> <time datetime="<%= date_xml(card.latest) %>"><%= date(card.latest, 'YYYY-MM-DD') %></time></p>
            </article>
        </li>
    <% }) %>
</ol>
