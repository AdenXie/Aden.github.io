<%# Daily brief section (scripts/brief-split.js): cards reuse the home card list,
    the list view reuses the archive timeline. Styles: lib/styles/home-cards.css. %>
<% const labels = page.daily_labels; const cards = page.daily_view === 'cards'; %>
<div class="aden-daily aden-daily--<%= page.daily_view %>">
    <header class="aden-daily-header">
        <div>
            <h1 class="aden-daily-title"><%= page.title %></h1>
            <p class="aden-daily-meta"><%= page.daily_meta %></p>
            <p class="aden-daily-note"><span>ALL IN AI</span><%= page.daily_note %></p>
        </div>
        <nav class="aden-daily-views" aria-label="<%= labels.views %>">
            <a href="<%- url_for('/daily/') %>"<% if (cards) { %> class="active" aria-current="page"<% } %>><i class="fa-regular fa-grid-2"></i><%= labels.cards %></a>
            <a href="<%- url_for('/daily/list/') %>"<% if (!cards) { %> class="active" aria-current="page"<% } %>><i class="fa-regular fa-list"></i><%= labels.list %></a>
        </nav>
    </header>
    <% if (cards) { %>
        <%- partial('pages/home/home-content') %>
    <% } else { %>
        <div class="archive-container shadow-none hover:shadow-none sm:shadow-redefine sm:hover:shadow-redefine-hover">
            <%- partial('utils/posts-list', {posts: page.posts}) %>
        </div>
    <% } %>
</div>
