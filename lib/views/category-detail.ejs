<%# One category's posts (scripts/archive-view.js), in the same year and month sections as the archive. %>
<% const english = (config.language || '').startsWith('en'); const posts = page.posts.sort('-date').toArray(); %>
<header class="aden-archive-header">
    <p class="aden-archive-back"><a href="<%- url_for('/categories/') %>"><%= english ? 'All categories' : '全部分类' %></a></p>
    <h1 class="page-title-header"><i class="fa-solid fa-folder" aria-hidden="true"></i>&nbsp;<%= page.category %></h1>
    <p class="aden-archive-summary"><%= english ? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}` : `${posts.length} 篇` %></p>
</header>
<%- partial('pages/archive/post-index', { posts, showCategories: false }) %>
