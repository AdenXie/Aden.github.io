<%# One tag's posts (scripts/archive-view.js), in the same year and month sections as the archive. %>
<% const english = (config.language || '').startsWith('en'); const posts = page.posts.sort('-date').toArray(); const tagDoc = site.tags.findOne({ name: page.tag }); const total = tagDoc ? tagDoc.posts.length : posts.length; const pages = page.total || 1; const current = page.current || 1; %>
<header class="aden-archive-header">
    <p class="aden-archive-back"><a href="<%- url_for('/tags/') %>"><%= english ? 'All tags' : '全部标签' %></a></p>
    <h1 class="page-title-header"><i class="fa-solid fa-tag" aria-hidden="true"></i>&nbsp;<%= page.tag %></h1>
    <p class="aden-archive-summary"><%= english ? `${total} ${total === 1 ? 'post' : 'posts'}` : `共 ${total} 篇` %><% if (pages > 1) { %><%= english ? ` · page ${current} of ${pages}` : ` · 第 ${current}/${pages} 页` %><% } %></p>
</header>
<%- partial('pages/archive/post-index', { posts, showCategories: false }) %>
