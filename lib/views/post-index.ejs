<%# Year and month sections, one line per post (scripts/archive-view.js). Shared by the archive and each category page. %>
<% const english = (config.language || '').startsWith('en'); const groups = aden_archive_groups(posts, english); %>
<div class="aden-archive">
    <% if (groups.length > 1) { %>
        <nav class="aden-archive-jump" aria-label="<%= english ? 'Jump to a year' : '跳转到年份' %>">
            <ul>
                <% groups.forEach(group => { %>
                    <li><a href="#year-<%= group.year %>"><%= group.year %><span class="aden-archive-count"><%= group.count %></span></a></li>
                <% }) %>
            </ul>
        </nav>
    <% } %>
    <% groups.forEach(group => { %>
        <section class="aden-archive-year" id="year-<%= group.year %>" aria-labelledby="year-<%= group.year %>-title">
            <h2 class="aden-archive-year-title" id="year-<%= group.year %>-title"><%= group.year %><span class="aden-archive-count"><%= group.count %> <%= english ? (group.count === 1 ? 'post' : 'posts') : '篇' %></span></h2>
            <% group.months.forEach(month => { %>
                <section class="aden-archive-month" aria-labelledby="month-<%= group.year %>-<%= month.month %>">
                    <h3 class="aden-archive-month-title" id="month-<%= group.year %>-<%= month.month %>"><%= month.name %><span class="aden-archive-count"><%= month.posts.length %></span></h3>
                    <ol class="aden-archive-entries">
                        <% month.posts.forEach(post => { %>
                            <li class="aden-archive-entry">
                                <time class="aden-archive-date" datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM-DD') %></time>
                                <a class="aden-archive-link" href="<%- url_for(post.path) %>" title="<%= post.title %>"><%= post.title %></a>
                                <% if (showCategories) { %>
                                    <span class="aden-archive-meta"><%= post.categories.map(category => category.name).join(' · ') %></span>
                                <% } %>
                            </li>
                        <% }) %>
                    </ol>
                </section>
            <% }) %>
        </section>
    <% }) %>
</div>
