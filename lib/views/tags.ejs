<%# Tag index (scripts/archive-view.js): common tags (3 or more posts) as chips, the rest as a column list. %>
<% const english = (config.language || '').startsWith('en'); const tiers = aden_tag_tiers(site.tags, english); %>
<header class="aden-archive-header">
    <h1 class="page-title-header"><%= english ? 'Tags' : '标签' %></h1>
    <p class="aden-archive-summary"><%= english ? `${tiers.total} ${tiers.total === 1 ? 'tag' : 'tags'}` : `${tiers.total} 个标签` %></p>
</header>
<% if (tiers.common.length) { %>
    <section class="aden-tag-section" aria-labelledby="tags-common">
        <h2 class="aden-tag-heading" id="tags-common"><%= english ? 'Common tags' : '常用标签' %><span class="aden-archive-count"><%= english ? '3 or more posts' : '3 篇及以上' %></span></h2>
        <ul class="aden-tag-chips">
            <% tiers.common.forEach(tag => { %>
                <li>
                    <a class="aden-tag-chip<%= tag.major ? ' is-major' : '' %>" href="<%- url_for(tag.path) %>">
                        <span class="aden-tag-hash" aria-hidden="true">#</span>
                        <span class="aden-tag-name"><%= tag.name %></span>
                        <span class="aden-tag-number"><%= tag.count %><span class="aden-sr-only"> <%= english ? (tag.count === 1 ? 'post' : 'posts') : '篇' %></span></span>
                    </a>
                </li>
            <% }) %>
        </ul>
    </section>
<% } %>
<% if (tiers.other.length) { %>
    <section class="aden-tag-section" aria-labelledby="tags-other">
        <h2 class="aden-tag-heading" id="tags-other"><%= english ? 'Other tags' : '其他标签' %><span class="aden-archive-count"><%= english ? '1 or 2 posts' : '1–2 篇' %></span></h2>
        <ul class="aden-tag-list">
            <% tiers.other.forEach(tag => { %>
                <li>
                    <a href="<%- url_for(tag.path) %>"><span class="aden-tag-name"><%= tag.name %></span><span class="aden-tag-number"><%= tag.count %><span class="aden-sr-only"> <%= english ? (tag.count === 1 ? 'post' : 'posts') : '篇' %></span></span></a>
                </li>
            <% }) %>
        </ul>
    </section>
<% } %>
